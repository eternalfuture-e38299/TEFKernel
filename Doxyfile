PROJECT_NAME = "tefkernel"

# 输入控制
INPUT = src include
RECURSIVE = YES
EXCLUDE = src/tefpackage/lz4.c \
          src/tefpackage/lz4.h \
          src/tefpackage/lz4hc.c \
          src/tefpackage/lz4hc.h

# 排除 patchlib 目录及其所有子目录
EXCLUDE_PATTERNS = */patchlib/* */tefstd/*
EXCLUDE += include/patchlib/ src/patchlib/ src/patchlib include/patchlib

# 输出控制
OUTPUT_DIRECTORY = docs
GENERATE_HTML = YES
GENERATE_LATEX = NO
SHOW_USED_FILES = YES
GENERATE_XML = YES

# 图形生成
HAVE_DOT = YES
CALL_GRAPH = YES
CALLER_GRAPH = YES
DOT_IMAGE_FORMAT = svg

# 文档提取 - 强制提取所有代码
EXTRACT_ALL = YES
EXTRACT_PRIVATE = YES
EXTRACT_STATIC = YES
EXTRACT_LOCAL_METHODS = YES
EXTRACT_ANON_NSPACES = YES
HIDE_UNDOC_MEMBERS = NO
HIDE_UNDOC_CLASSES = NO
HIDE_IN_BODY_DOCS = NO
INTERNAL_DOCS = YES
SHOW_INCLUDE_FILES = YES
