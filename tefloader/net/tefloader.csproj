<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <StartupObject>tefloader.Program</StartupObject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <TargetFrameworks>net472;net452</TargetFrameworks>
        <Platforms>AnyCPU</Platforms>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net452'">
        <AssemblyName>tefloader</AssemblyName>
        <PlatformTarget>x86</PlatformTarget>
        <Prefer32Bit>true</Prefer32Bit>
        <DefineConstants>NETFRAMEWORK;NET452</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
        <AssemblyName>tefloader</AssemblyName>
        <DefineConstants>NETFRAMEWORK;NET472</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="HarmonyX" Version="2.16.1" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="Fody" Version="6.9.3">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Costura.Fody" Version="6.0.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
        <Reference Include="Microsoft.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="System" />
        <Using Include="System.Collections.Generic" />
        <Using Include="System.Linq" />
        <Using Include="System.Text" />
        <Using Include="System.Threading.Tasks" />
    </ItemGroup>

    <!--
        Windows 上 tefloader 需要承载 Terraria（32 位）以及 .NET 运行时和内核。
        不设置 LARGE_ADDRESS_AWARE 时进程只有 2GB 用户地址空间，游戏加载到
        后期会在 GraphicsDevice.Present 处 OutOfMemoryException。
        Terraria.exe 本身带有该标志，tefloader 默认没有，这里补上。
    -->
    <UsingTask TaskName="SetLargeAddressAware"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <FilePath ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Code Type="Fragment" Language="cs">
                <![CDATA[
                var bytes = File.ReadAllBytes(FilePath);
                if (bytes.Length > 0x40 && bytes[0] == (byte)'M' && bytes[1] == (byte)'Z')
                {
                    int pe = BitConverter.ToInt32(bytes, 0x3C);
                    if (pe > 0 && pe + 0x40 < bytes.Length &&
                        bytes[pe] == (byte)'P' && bytes[pe + 1] == (byte)'E')
                    {
                        int characteristicsOffset = pe + 4 + 18;
                        ushort characteristics = BitConverter.ToUInt16(bytes, characteristicsOffset);
                        if ((characteristics & 0x20) == 0)
                        {
                            characteristics |= 0x20; // IMAGE_FILE_LARGE_ADDRESS_AWARE
                            BitConverter.GetBytes(characteristics).CopyTo(bytes, characteristicsOffset);
                            File.WriteAllBytes(FilePath, bytes);
                        }
                    }
                }
                ]]>
            </Code>
        </Task>
    </UsingTask>

    <Target Name="MarkLargeAddressAware"
            AfterTargets="Build"
            Condition="'$(OS)' == 'Windows_NT' and '$(TargetFrameworkIdentifier)' == '.NETFramework'">
        <SetLargeAddressAware FilePath="$(TargetPath)" />
    </Target>
</Project>